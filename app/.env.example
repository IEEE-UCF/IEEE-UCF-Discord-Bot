# ==============================================================================
# IEEE UCF Discord Bot — Environment Variables Configuration (.env)
# ==============================================================================
# Copy this file to '.env' in the project root directory and fill in your values.
# NEVER commit your actual '.env' file containing secret tokens to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD BOT CREDENTIALS
# ------------------------------------------------------------------------------
# DISCORD_TOKEN: The Secret Bot Token obtained from Discord Developer Portal
# Go to: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# DISCORD_CLIENT_ID: The Application / Client ID for your Discord Bot
# Go to: https://discord.com/developers/applications -> General Information -> Application ID
DISCORD_CLIENT_ID=
# ------------------------------------------------------------------------------
# 2. DISCORD SERVER & ROLE IDs
# ------------------------------------------------------------------------------
# MAIN_SERVER_ID: The Discord Server (Guild) ID for IEEE UCF (or your test server)
# Enable Discord Developer Mode -> Right click server icon -> Copy Server ID
MAIN_SERVER_ID=

# ROLE_REMINDER_ID: The Role ID to ping for 1-hour event reminders (e.g., @Events / @Members)
ROLE_REMINDER_ID=

# ROLE_ASSISTANCE_ADMIN_ID: (Optional) Role ID for Admin Support ticketing
ROLE_ASSISTANCE_ADMIN_ID=

# ROLE_ASSISTANCE_SOFTWARE_ID: (Optional) Role ID for Software Committee support
ROLE_ASSISTANCE_SOFTWARE_ID=

# ------------------------------------------------------------------------------
# 3. DISCORD CHANNEL IDs
# ------------------------------------------------------------------------------
# CHANNEL_CALENDAR_ID: The Channel ID where the automated Weekly Events Board is posted
CHANNEL_CALENDAR_ID=

# CHANNEL_REMINDERS_ID: The Channel ID where 1-hour upcoming event pings are sent
CHANNEL_REMINDERS_ID=

# CHANNEL_ASSISTANCE_ID: The Channel ID designated for user help & ticketing
CHANNEL_ASSISTANCE_ID=

# CHANNEL_GENERAL_ID: The main general text channel
CHANNEL_GENERAL_ID=

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL Connection String
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. CALENDAR & AUTOMATION SETTINGS
# ------------------------------------------------------------------------------
# CALENDAR_ICAL_URL: Public iCal (.ics) feed URL from Google Calendar
CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/ieee.ucf%40gmail.com/public/basic.ics

# EVENTS_AUTOMATION_ENABLED: Automatically post/update weekly board in #calendar ('true' or 'false')
EVENTS_AUTOMATION_ENABLED=

# EVENTS_AUTOMATION_INTERVAL_MINS: How often (in minutes) to refresh the weekly board
EVENTS_AUTOMATION_INTERVAL_MINS=

# EVENT_REMINDERS_ENABLED: Send 1-hour event reminders ('true' or 'false')
EVENT_REMINDERS_ENABLED=

# EVENT_REMINDERS_MINUTES: How many minutes before an event to trigger the reminder ping
EVENT_REMINDERS_MINUTES=

# ------------------------------------------------------------------------------
# 6. BOT APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# DEBUG: Enable verbose logging output in terminal ('true' or 'false')
DEBUG=false
